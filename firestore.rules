rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && (request.auth.token.email == "sadik22319@gmail.com"
            || request.auth.token.email == "rockysencr7@gmail.com");
    }

    match /heritageContent/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /funFacts/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId}/passport/{documentId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.status == "approved";
      allow update: if request.auth != null
                    && (
                      resource.data.authorId == request.auth.uid
                      || (
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(["likes", "likedBy"])
                      )
                    );
      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if request.auth != null
                              && resource.data.authorId == request.auth.uid;
      }
    }
    match /userReports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read: if (request.auth != null && request.auth.uid == resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

  }
}
